rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for system config so all links (preview and deployed) sync Google Sheets config
    match /system_config/{document} {
      allow read, write: if true;
    }
    // Allow sales access
    match /sales/{document} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null || true;
    }
  }
}
